// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  MEMBER
  BOOSTER
  ADMIN
  SUPERADMIN
}

enum BoosterApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutAccountType {
  BANK
  EWALLET
  CRYPTO
}

// Service detail configuration enums
enum ServiceInputType {
  select
  radio
  range
  checkbox
  input
}

enum ServiceDisplayType {
  number
  text
  dual
  single
}

enum ServicePriceType {
  fixed
  percent
}

model User {
  id            String   @id @default(cuid())
  name          String?
  username      String   @unique
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role     @default(MEMBER)
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  boosterApplications BoosterApplication[]
  posts         Post[]
  orders        Order[]  @relation("OrderCustomer")
  boosterOrders Order[]  @relation("OrderBooster")
  boosterServices BoosterService[]
  orderMessages OrderMessage[]
  wallet       Wallet?
  payoutAccounts BoosterPayoutAccount[]
  reviews      Review[]
  withdrawals  BoosterWithdrawal[]
  adminPermissions AdminUserPermission[]

  @@index([createdAt])
  @@index([role])
  @@index([isSuspended])
}

model BoosterPayoutAccount {
  id           Int              @id @default(autoincrement())
  userId       String
  type         PayoutAccountType
  providerName String
  accountName  String
  accountRef   String           @db.VarChar(255)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals BoosterWithdrawal[]

  @@index([userId, isActive, createdAt])
  @@unique([userId, providerName, accountRef])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BoosterApplication {
  id         Int                      @id @default(autoincrement())
  userId     String?
  fullName   String?
  email      String?
  discord    String?
  whatsapp   String?
  games      String?                  @db.Text
  status     BoosterApplicationStatus @default(PENDING)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

// Per-admin access, set by a super admin. When an admin has no rows here,
// the shared AdminPermission defaults below apply.
model AdminUserPermission {
  id        Int      @id @default(autoincrement())
  userId    String
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model AdminPermission {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model Game {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  imageUrl    String?
  iconUrl     String?
  description String?  @db.Text
  isHotOffer  Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(9999)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categories  Category[]
  services    Service[]

  @@index([isActive, createdAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  gameId    Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(9999)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([gameId, isActive])
  @@unique([name, gameId])
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  gameId      Int
  categoryId  Int?
  description String?  @db.Text
  imageUrl    String?
  features    Json?
  price       Decimal  @db.Decimal(10, 2)
  isHotOffer  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  details  ServiceDetail[]
  orders   Order[]
  reviews  Review[]
  boosters BoosterService[]

  @@index([gameId, categoryId])
  @@index([isActive, createdAt])
}

// Per-service configurable data for pricing/options
model ServiceDetail {
  id          Int               @id @default(autoincrement())
  serviceId   Int
  title       String
  fieldName   String
  inputType   ServiceInputType
  displayType ServiceDisplayType?
  priceType   ServicePriceType  @default(fixed)
  price       Decimal           @db.Decimal(10, 2) @default(0)
  sortOrder   Int               @default(0)
  options     Json?
  range       Json?
  inputMeta   Json?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, isActive, sortOrder])
}
model WebsiteSetting {
  id           String   @id @default("singleton")
  siteName     String   @default("Gamingqu")
  tagline      String?
  logoUrl      String?
  faviconUrl   String?
  contactEmail String?
  contactPhone String?
  /// Currency: base is USD; eurPerUsd means 1 USD equals X EUR
  eurPerUsd    Decimal? @db.Decimal(10, 4)
  /// Revenue split percentages
  webSharePercent     Decimal? @db.Decimal(10, 4)
  boosterSharePercent Decimal? @db.Decimal(10, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum EmbedPlacement {
  HEAD
  BODY
  FOOTER
}

model EmbedCode {
  id        Int            @id @default(autoincrement())
  name      String
  code      String         @db.Text
  placement EmbedPlacement
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([placement, isActive])
  @@index([createdAt])
}

model FooterSetting {
  id                 String   @id @default("singleton")
  disclaimer         String?  @db.Text
  shortDescription   String?  @db.Text
  copyright          String?
  legalAddress       String?
  regNumber          String?
  smTelegramUrl      String?
  smYoutubeUrl       String?
  smDiscordUrl       String?
  smFacebookUrl      String?
  navHomeTitle       String?
  navHomeUrl         String?
  navAboutTitle      String?
  navAboutUrl        String?
  navFaqTitle        String?
  navFaqUrl          String?
  navBoosterTitle    String?
  navBoosterUrl      String?
  legal1Title        String?
  legal1Url          String?
  legal2Title        String?
  legal2Url          String?
  legal3Title        String?
  legal3Url          String?
  legal4Title        String?
  legal4Url          String?
  pmVisaUrl          String?
  pmMastercardUrl    String?
  pmGpayUrl          String?
  pmApplePayUrl      String?
  pmPaypalUrl        String?
  pmStripeUrl        String?
  badgeMastercardUrl String?
  badgeVisaUrl       String?
  badgePciUrl        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
}

model Banner {
  id             Int      @id @default(autoincrement())
  title          String?
  subtitle       String?
  buttonLink     String?
  buttonImageUrl String?
  order          Int?     @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, order])
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String?  @db.LongText
  imageUrl    String?
  sourceUrl   String?  @db.Text
  authorId    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished, createdAt])
  @@index([slug])
}

model ScraperSource {
  id          Int      @id @default(autoincrement())
  name        String
  url         String   @unique
  scrapeInterval Int   @default(60) // Interval in minutes
  lastRunAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentMethod {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  iconUrl    String?
  feePercent Decimal? @db.Decimal(10, 4)
  feeFixed   Decimal? @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Checkout and payment
enum OrderStatus {
  CREATED
  PENDING
  PAID
  CANCELED
  FAILED
}

enum PaymentStatus {
  CREATED
  APPROVAL_REQUIRED
  APPROVED
  CAPTURED
  CANCELED
  FAILED
}

enum OrderFulfillmentStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  WAITING_CONFIRM
  COMPLETED
  CANCELED
}

model Order {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  userId        String?
  serviceId     Int
  serviceSlug   String
  methodSlug    String
  items         Decimal     @db.Decimal(10, 2)
  fee           Decimal     @db.Decimal(10, 2)
  amount        Decimal     @db.Decimal(10, 2)
  boosterPay    Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD")
  status        OrderStatus @default(CREATED)
  fulfillmentStatus OrderFulfillmentStatus @default(PENDING)
  contactEmail  String?
  contactDiscord String?
  characterName String?
  payload       Json?
  // Booster who accepted the job; null while it is open.
  boosterId     String?
  acceptedAt    DateTime?
  // Booster marked the job done; the customer or an admin confirms it.
  doneAt        DateTime?
  completedAt   DateTime?
  // Set once when the booster's pay is credited to their wallet.
  paidOutAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user    User?    @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  booster User?    @relation("OrderBooster", fields: [boosterId], references: [id], onDelete: SetNull)
  service Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  payments Payment[]
  walletTransactions WalletTransaction[]
  reviews Review[]
  messages OrderMessage[]

  @@index([userId, status, createdAt])
  @@index([serviceId, methodSlug])
  @@index([boosterId, fulfillmentStatus])
}

// Services a booster has chosen to work on; they only see jobs for these.
model BoosterService {
  id        Int      @id @default(autoincrement())
  userId    String
  serviceId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@index([serviceId])
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int
  provider        String
  providerOrderId String?
  approvalUrl     String?       @db.Text
  status          PaymentStatus @default(CREATED)
  raw             Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, provider, status])
}

// Wallet & Reviews
enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  REJECTED
  PAID
}
model Wallet {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  balance   Decimal  @db.Decimal(12, 2) @default(0)
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
  @@index([isActive])
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  walletId    Int
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(12, 2)
  description String?
  orderId     Int?
  createdAt   DateTime              @default(now())

  wallet Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([orderId])
}

model Review {
  id          Int      @id @default(autoincrement())
  userId      String
  serviceId   Int?
  orderId     Int?
  rating      Int      @default(5)
  title       String?
  comment     String?  @db.Text
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, isPublished, createdAt])
  @@index([serviceId])
  @@index([orderId])
}

model Page {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String?  @db.LongText
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model BoosterWithdrawal {
  id         Int              @id @default(autoincrement())
  userId     String
  accountId  Int
  amount     Decimal          @db.Decimal(12, 2)
  currency   String           @default("USD")
  status     WithdrawalStatus @default(PENDING)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account BoosterPayoutAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([accountId])
}

// Chat between the customer, the assigned booster and admins on one order.
model OrderMessage {
  id        Int      @id @default(autoincrement())
  orderId   Int
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}
