// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  MEMBER
  BOOSTER
  ADMIN
  SUPERADMIN
}

enum BoosterApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Service detail configuration enums
enum ServiceInputType {
  select
  radio
  range
  checkbox
  input
}

enum ServiceDisplayType {
  number
  text
  dual
  single
}

enum ServicePriceType {
  fixed
  percent
}

model User {
  id            String   @id @default(cuid())
  name          String?
  username      String   @unique
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role     @default(MEMBER)
  isSuspended   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  boosterApplications BoosterApplication[]
  posts         Post[]

  @@index([createdAt])
  @@index([role])
  @@index([isSuspended])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BoosterApplication {
  id         Int                      @id @default(autoincrement())
  userId     String
  status     BoosterApplicationStatus @default(PENDING)
  motivation String?                  @db.Text
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}

model AdminPermission {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model Game {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  imageUrl    String?
  iconUrl     String?
  description String?  @db.Text
  isHotOffer  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categories  Category[]
  services    Service[]

  @@index([isActive, createdAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  gameId    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([gameId, isActive])
  @@unique([name, gameId])
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  gameId      Int
  categoryId  Int?
  description String?  @db.Text
  imageUrl    String?
  features    Json?
  price       Decimal  @db.Decimal(10, 2)
  isHotOffer  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  details  ServiceDetail[]

  @@index([gameId, categoryId])
  @@index([isActive, createdAt])
}

// Per-service configurable data for pricing/options
model ServiceDetail {
  id          Int               @id @default(autoincrement())
  serviceId   Int
  title       String
  fieldName   String
  inputType   ServiceInputType
  displayType ServiceDisplayType?
  priceType   ServicePriceType  @default(fixed)
  price       Decimal           @db.Decimal(10, 2) @default(0)
  sortOrder   Int               @default(0)
  options     Json?
  range       Json?
  inputMeta   Json?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, isActive, sortOrder])
}
model WebsiteSetting {
  id           String   @id @default("singleton")
  siteName     String   @default("Gamingqu")
  tagline      String?
  logoUrl      String?
  faviconUrl   String?
  contactEmail String?
  contactPhone String?
  /// Currency: base is USD; eurPerUsd means 1 USD equals X EUR
  eurPerUsd    Decimal? @db.Decimal(10, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum EmbedPlacement {
  HEAD
  BODY
  FOOTER
}

model EmbedCode {
  id        Int            @id @default(autoincrement())
  name      String
  code      String         @db.Text
  placement EmbedPlacement
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([placement, isActive])
  @@index([createdAt])
}

model FooterSetting {
  id                 String   @id @default("singleton")
  disclaimer         String?  @db.Text
  shortDescription   String?  @db.Text
  copyright          String?
  legalAddress       String?
  regNumber          String?
  smTelegramUrl      String?
  smYoutubeUrl       String?
  smDiscordUrl       String?
  smFacebookUrl      String?
  navHomeTitle       String?
  navHomeUrl         String?
  navAboutTitle      String?
  navAboutUrl        String?
  navFaqTitle        String?
  navFaqUrl          String?
  navBoosterTitle    String?
  navBoosterUrl      String?
  legal1Title        String?
  legal1Url          String?
  legal2Title        String?
  legal2Url          String?
  legal3Title        String?
  legal3Url          String?
  legal4Title        String?
  legal4Url          String?
  pmVisaUrl          String?
  pmMastercardUrl    String?
  pmGpayUrl          String?
  pmApplePayUrl      String?
  pmPaypalUrl        String?
  pmStripeUrl        String?
  badgeMastercardUrl String?
  badgeVisaUrl       String?
  badgePciUrl        String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive])
}

model Banner {
  id             Int      @id @default(autoincrement())
  title          String?
  subtitle       String?
  buttonLink     String?
  buttonImageUrl String?
  order          Int?     @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, order])
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String?  @db.LongText
  imageUrl    String?
  sourceUrl   String?  @db.Text
  authorId    String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished, createdAt])
  @@index([slug])
}

model ScraperSource {
  id          Int      @id @default(autoincrement())
  name        String
  url         String   @unique
  scrapeInterval Int   @default(60) // Interval in minutes
  lastRunAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
